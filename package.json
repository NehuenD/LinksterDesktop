{
  "name": "linkster",
  "version": "0.1.0",
  "description": "Cross-platform read-later desktop app with automatic clipboard capture.",
  "type": "module",
  "main": "./out/main/index.js",
  "license": "MIT",
  "author": "Linkster",
  "scripts": {
    "dev": "electron-vite dev",
    "native:build": "node-gyp rebuild -C native/clipboard-listener",
    "native:verify": "electron scripts/verify-native-clipboard.cjs",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "dist": "npm run native:build && npm run build && electron-builder",
    "dist:win": "npm run native:build && npm run build && electron-builder --win",
    "dist:mac": "npm run native:build && npm run build && electron-builder --mac",
    "dist:linux": "npm run native:build && npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "node-html-parser": "^9.0.4",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "node-addon-api": "^8.9.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  }
}
