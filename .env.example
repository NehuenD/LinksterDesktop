# Linkster environment variables
#
# These are consumed by electron-vite and inlined into the main-process bundle.
# The Supabase anon key is a public, RLS-constrained credential, so inlining is
# expected; per-user isolation is enforced by Row Level Security on the server.

MAIN_VITE_SUPABASE_URL=
MAIN_VITE_SUPABASE_ANON_KEY=
